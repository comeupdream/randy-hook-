# --- Database (production web service mode) --------------------------------
# Any hosted Postgres works: Render, Neon, Supabase, Railway, RDS…
DATABASE_URL="postgresql://user:password@host:5432/randy_hook_lcsw"

# --- Admin sign-in ----------------------------------------------------------
# Password for /admin (the practice's appointment book).
ADMIN_PASSWORD="change-me"
# Secret used to sign the admin session cookie. Any long random string.
SESSION_SECRET="change-me-to-a-long-random-string"

# --- Public site URL (links in emails + metadata) ---------------------------
NEXT_PUBLIC_SITE_URL="https://www.randyhooklcsw.com"

# --- Email (optional — bookings work without it; see README) ----------------
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Randy Hook, LCSW <hello@randyhooklcsw.com>"
# OWNER_EMAIL="randy@randyhooklcsw.com"

# --- Reminder cron ----------------------------------------------------------
# Protects /api/cron/reminders. Hit it hourly from any scheduler.
# CRON_SECRET="change-me"
